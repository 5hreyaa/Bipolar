# Database Configuration
# Replace with your Neon PostgreSQL connection string in .env
# Format: postgresql+psycopg2://<user>:<password>@<neon-host>/<dbname>?sslmode=require
DATABASE_URL=postgresql+psycopg2://user:password@ep-example.us-east-2.aws.neon.tech/snack_overflow?sslmode=require

# Optional separate test database URL (defaults to isolated local SQLite test DB if omitted)
# TEST_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/snack_overflow_test

# JWT Security Configuration
JWT_SECRET_KEY=replace-with-a-secure-random-64-character-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# App Environment (development | production | test)
ENVIRONMENT=development

